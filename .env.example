# CampusMate Environment Variables
#
# HOW TO USE THIS FILE:
#   1. Duplicate this file and rename the copy to ".env"
#   2. Fill in the two values below with your Supabase project credentials
#   3. NEVER commit your real .env file to GitHub — it is already in .gitignore
#
# WHERE TO FIND THESE VALUES:
#   → Go to https://supabase.com and open your project
#   → Click "Project Settings" in the left sidebar
#   → Click "Data API" (or "API" in older dashboards)
#   → Copy "Project URL" and the "anon public" key

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
